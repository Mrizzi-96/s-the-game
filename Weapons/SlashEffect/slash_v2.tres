[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 ColorParameter : source_color;
uniform float Progress : hint_range(-1.0, 1.0) = 0.0;
uniform sampler2D BaseTexture : filter_nearest, repeat_disable;
uniform vec4 HighlightColor : source_color;
uniform sampler2D HighlightTexture : filter_nearest, repeat_disable;
uniform sampler2D DissolveTexture;
uniform float DissolveParameter : hint_range(0.0, 1.0) = 0.0;



void fragment() {
// ColorParameter:9
	vec4 n_out9p0 = ColorParameter;


// Input:4
	vec2 n_out4p0 = UV;


// VectorDecompose:5
	float n_out5p0 = n_out4p0.x;
	float n_out5p1 = n_out4p0.y;


// FloatParameter:6
	float n_out6p0 = Progress;


// FloatOp:7
	float n_out7p0 = n_out5p0 - n_out6p0;


// VectorCompose:8
	vec2 n_out8p0 = vec2(n_out7p0, n_out5p1);


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(BaseTexture, n_out8p0);
	float n_out3p4 = n_out3p0.a;


// VectorOp:10
	vec4 n_out10p0 = n_out9p0 * n_out3p0;


// ColorParameter:15
	vec4 n_out15p0 = HighlightColor;


	vec4 n_out11p0;
// Texture2D:11
	n_out11p0 = texture(HighlightTexture, n_out8p0);


// VectorOp:16
	vec4 n_out16p0 = n_out15p0 * n_out11p0;
	float n_out16p4 = n_out16p0.a;


// VectorDecompose:14
	float n_out14p0 = n_out16p0.x;
	float n_out14p1 = n_out16p0.y;
	float n_out14p2 = n_out16p0.z;
	float n_out14p3 = n_out16p0.w;


// Mix:13
	vec4 n_out13p0 = mix(n_out10p0, n_out16p0, vec4(n_out14p3));


// FloatFunc:23
	float n_out23p0 = 1.0 - n_out3p4;


// FloatOp:24
	float n_out24p0 = n_out23p0 * n_out16p4;


// FloatOp:25
	float n_out25p0 = n_out3p4 + n_out24p0;


// Clamp:26
	float n_in26p1 = 0.00000;
	float n_in26p2 = 1.00000;
	float n_out26p0 = clamp(n_out25p0, n_in26p1, n_in26p2);


	vec4 n_out18p0;
// Texture2D:18
	n_out18p0 = texture(DissolveTexture, UV);


// FloatParameter:19
	float n_out19p0 = DissolveParameter;


// FloatOp:20
	float n_out20p0 = n_out18p0.x - n_out19p0;


// Clamp:21
	float n_in21p1 = 0.00000;
	float n_in21p2 = 1.00000;
	float n_out21p0 = clamp(n_out20p0, n_in21p1, n_in21p2);


// FloatOp:22
	float n_out22p0 = n_out26p0 * n_out21p0;


// Output:0
	COLOR.rgb = vec3(n_out13p0.xyz);
	COLOR.a = n_out22p0;


}
